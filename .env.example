# Copy to .env and fill in. Never commit .env.

# -----------------------------------------------------------------------------
# Postgres + Redis (used by docker-compose and the backend itself)
# -----------------------------------------------------------------------------
POSTGRES_DB=syphax
POSTGRES_USER=syphax
POSTGRES_PASSWORD=syphax
# DATABASE_URL is built automatically inside docker-compose; only set this if
# you run the backend outside docker.
# DATABASE_URL=postgresql://syphax:syphax@localhost:5432/syphax
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# LLM router - one client per role (Planner / Executor / Validator).
# All endpoints are OpenAI-compatible Chat Completions APIs.
#
# PRIMARY providers (set the API key to activate a role):
#
#   Moonshot (Kimi) - https://platform.moonshot.ai - long-horizon agentic
#       reasoning, 1M context. Prepaid credit, no subscription (top up $1 to
#       activate). kimi-k3 is slow (~28 tok/s, ~4s to first token) because it
#       always reasons, which is why only the planner runs on it below.
#       base_url -> https://api.moonshot.ai/v1   model -> kimi-k3
#       Note: api.moonshot.CN is the China platform with a separate account.
#   Z.ai (Zhipu GLM) - https://z.ai - pay-as-you-go, 3-5x cheaper and faster.
#       base_url -> https://api.z.ai/api/paas/v4  model -> glm-5.2
#
# Default below: planner on Kimi K3 (quality where the decisions are made),
# executor and validator on GLM (speed and cost where the volume is).
# Leave a role's KEY blank and it falls back to OpenRouter (so the stack
# still works with zero paid keys - see the fallback block at the bottom).

# --- Planner: strongest reasoning (decides next moves) ---
PLANNER_BASE_URL=https://api.moonshot.ai/v1
PLANNER_API_KEY=
PLANNER_MODEL=kimi-k3

# --- Executor: cheap + fast (drives tool calls) ---
EXECUTOR_BASE_URL=https://api.z.ai/api/paas/v4
EXECUTOR_API_KEY=
EXECUTOR_MODEL=glm-5.2

# --- Validator: accurate (confirms findings, kills false positives) ---
VALIDATOR_BASE_URL=https://api.z.ai/api/paas/v4
VALIDATOR_API_KEY=
VALIDATOR_MODEL=glm-5.2

# All three roles on one provider is fine too - just repeat the same
# BASE_URL/KEY/MODEL triple. Older models still work: glm-4.6, kimi-k2.5.

# Any OpenAI-compatible endpoint works, including a router. Example: OrcaRouter
# (BYOK, zero markup, routes by prompt difficulty):
#   EXECUTOR_BASE_URL=https://api.orcarouter.ai/v1
#   EXECUTOR_MODEL=qwen/qwen3.8-27b
# A long-context model on the executor role pays off directly: that role runs
# the response analyst, which is fed raw captured traffic (see LLM_RECON_* below).

# -----------------------------------------------------------------------------
# LLM response analyst (llm-recon) context budget.
# The analyst spots cross-endpoint correlations, so it improves with the amount
# of real traffic it sees - bounded by the model's context window.
# Flows are ranked (server errors > auth/validation errors > parameterised >
# plain 200s > 404s) and added until either cap is hit.
# Defaults suit a ~128K-context model. For a 262K model (e.g. Qwen3.8-27B):
#   LLM_RECON_MAX_FLOWS=200
#   LLM_RECON_BUDGET_CHARS=600000
# -----------------------------------------------------------------------------
LLM_RECON_MAX_FLOWS=60
LLM_RECON_BODY_CHARS=6000
LLM_RECON_BUDGET_CHARS=150000

# -----------------------------------------------------------------------------
# API authentication. Empty = disabled, which is fine while the API is bound to
# 127.0.0.1 (the compose default). Set it before exposing 8000 or the mitmproxy
# port 8080 to anything else - the API can read captured sessions and bring up a
# VPN. Then paste the same value into Settings -> API key in the UI.
#   SYPHAX_API_KEY=$(openssl rand -hex 24)
# -----------------------------------------------------------------------------
SYPHAX_API_KEY=

# -----------------------------------------------------------------------------
# Cost accounting. WITHOUT THIS, the dashboard shows real token counts but
# $0.00 spend: estimate_cost() returns 0 for any model not listed here.
# Format: model=INPUT/OUTPUT in USD per 1M tokens.
# -----------------------------------------------------------------------------
LLM_PRICING=kimi-k3=3.0/15.0,glm-5.2=1.4/4.4,glm-4.6=0.6/2.2

# -----------------------------------------------------------------------------
# OpenRouter - OPTIONAL fallback aggregator. Used only for roles whose own
# API key is blank above. Free models work, so the stack runs with no paid
# key at all if you set just this (or nothing). Key: https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder:free
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-120b:free,qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_APP_NAME=syphax

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------

# Allowed CORS origins for the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Encrypts provider API keys saved via the Settings page (at rest). Generate
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, a key is generated and persisted to {DATA_DIR}/.settings.key.
SYPHAX_SECRET_KEY=

# Optional. WPScan uses its own vulnerability database for CVE correlation.
# Free tier: 25 requests/day per address. https://wpscan.com/register
WPSCAN_API_TOKEN=

# Optional. Raises the GitHub PoC search from 10 to 30 requests/minute, which a
# run with several CVEs burns through quickly. A fine-grained token with NO
# scopes is enough - the search API only reads public repositories.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Out-of-band (blind SSRF/XXE/RCE) confirmation server for nuclei. Leave EMPTY
# to use ProjectDiscovery's free public interactsh servers (oast.*) - no infra
# needed. Set to a self-hosted interactsh-server URL for privacy, e.g.
# https://oob.yourdomain.com
INTERACTSH_SERVER=

# -----------------------------------------------------------------------------
# Scan identity
# -----------------------------------------------------------------------------

# How the tools present themselves on the wire.
#   rotate - impersonate a different real browser per job (default). Rotates
#            the WHOLE profile: User-Agent plus the Accept, Accept-Language,
#            Sec-CH-UA and Sec-Fetch-* headers that browser actually sends.
#            Rotating the UA alone is its own signature, because a Firefox UA
#            arriving with Chrome client hints does not exist in the wild.
#   fixed  - pin USER_AGENT below instead.
#
# This defeats fingerprinting of *the tool*. It does not make a scan
# untraceable: source IP, request rate and payloads are all still logged, and
# rate is a far stronger signal than any header. Tune the scan rate in
# Settings if you need to stay quiet.
USER_AGENT_MODE=rotate
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# OFF by default, and leave it that way to blend in. When set, every request
# carries X-Pentest-ID: <value> so the client's SOC can tell an authorized
# test from a real intrusion. Only useful when the client asked for it.
PENTEST_ID=

# -----------------------------------------------------------------------------
# Network privacy (VPN / proxy)
# -----------------------------------------------------------------------------

# Refuse to queue ANY scan unless the exit IP is confirmed different from the
# pre-VPN IP. This is the kill switch: it stops a tunnel that dropped
# mid-engagement from silently leaking your real address.
REQUIRE_VPN=false

# SOCKS5/HTTP proxy for scan traffic. Needs no privileges and works with Tor:
#   socks5://127.0.0.1:9050
# Applied as per-tool flags (nuclei -proxy, ffuf -x, sqlmap --proxy, ...).
# Tools with no proxy support get no flag rather than a wrong one.
SCAN_PROXY=

# WireGuard/OpenVPN config, brought up via POST /api/network/vpn/connect.
# Requires NET_ADMIN (the backend container has it; the workers do not, which
# is why the kill switch is what protects them).
VPN_CONFIG_PATH=
VPN_MODE=wireguard

# -----------------------------------------------------------------------------
# Fresh start
# -----------------------------------------------------------------------------

# Truncate scan artefacts (jobs, findings, flows, events, runs, LLM usage) on
# every backend start, so a restart begins from a clean slate.
#
# NOTE this is the ONLY thing that clears data on a plain restart. Postgres and
# Redis live in named docker volumes, which survive `docker compose down` - you
# need `down -v` for those. And ./data is a bind mount, which survives even
# that. See "Full wipe" in the README.
RESET_ON_START=true

# Engagements hold the authorization scope and audit_log is the record of what
# was run against whom. Both survive a reset unless you opt in here.
RESET_ENGAGEMENTS_ON_START=false
RESET_AUDIT_ON_START=false
